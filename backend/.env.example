# =============================================================================
# AI Patient Front Desk — Environment Configuration
# =============================================================================
# Copy this file to .env and update values for your environment.
# Do NOT commit .env to version control.
# =============================================================================

# PostgreSQL connection string (async driver)
# Replace YOUR_PASSWORD with your actual PostgreSQL password.
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/ai_patient_frontdesk

# Application
APP_NAME=AI Patient Front Desk
VERSION=0.1.0
DEBUG=true
